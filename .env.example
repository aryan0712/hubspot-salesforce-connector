# ---------- App ----------
PORT=3000
LOG_LEVEL=debug
# Public URL where this server is reachable (used for webhook callbacks / OAuth redirects)
PUBLIC_BASE_URL=http://localhost:3000

# ---------- PostgreSQL (required for live mode) ----------
DATABASE_URL=postgresql://crm_sync:local-development-only@localhost:5432/crm_sync
DATABASE_SSL=false
DEFAULT_TENANT_SLUG=local
# Optional locally: when blank, the app creates data/.encryption-key with mode 0600.
# Production must supply a unique value of at least 32 characters.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_FILE=data/.encryption-key
AUTH_REQUIRED=false

# ---------- Salesforce (External Client App, OAuth 2.0) ----------
# NOTE: Salesforce disabled new "Connected App" creation (Winter '26 for new orgs, Spring '26 for all).
# Use an EXTERNAL CLIENT APP instead: Setup -> App Manager -> New External Client App.
#   - Enable OAuth; scopes: api, refresh_token, offline_access
#   - Enable the "Authorization Code and Credentials" flow
#   - "Require Proof Key for Code Exchange (PKCE)" can stay enabled — the app implements PKCE
# The SAME app works for Production AND Sandbox — the app picks the login host (login. vs test.
# salesforce.com) based on the environment you choose on the Connect screen. No separate app needed.
# Add this exact callback URL to the app's OAuth "Callback URL" list:
#   http://localhost:3000/auth/salesforce/callback
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REDIRECT_URI=http://localhost:3000/auth/salesforce/callback
# Optional: seed a connection without the web flow (otherwise connect via the UI):
SF_REFRESH_TOKEN=
SF_INSTANCE_URL=
# Webhook verification (from your Apex trigger / Platform Event push or a shared secret)
SF_WEBHOOK_SECRET=

# ---------- HubSpot (OAuth App) ----------
# Create an app at https://developers.hubspot.com (Apps -> Create app). Add the CRM scopes
# (contacts/companies/deals read+write) and this redirect URL:
#   http://localhost:3000/auth/hubspot/callback
# A "sandbox" in HubSpot is just a separate portal you pick during login — same OAuth app.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/auth/hubspot/callback
# Shortcut alternative to OAuth: a Private App token (skips the connect flow for HubSpot):
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_REFRESH_TOKEN=
# App secret used to validate incoming webhook signatures (X-HubSpot-Signature-v3)
HUBSPOT_APP_SECRET=

# ---------- Sync behavior ----------
# source-of-truth | last-write-wins | field-merge
CONFLICT_STRATEGY=last-write-wins
# When CONFLICT_STRATEGY=source-of-truth, which system wins: salesforce | hubspot
SOURCE_OF_TRUTH=salesforce
DELETE_POLICY=manual-review
SYNC_CONCURRENCY=4
SYNC_MAX_ATTEMPTS=8
HUBSPOT_REQUESTS_PER_SECOND=9
SALESFORCE_REQUESTS_PER_SECOND=20
# Development escape hatch only. Keep false in every hosted environment.
ALLOW_UNSIGNED_WEBHOOKS=false

# ---------- Read-only Migration Copilot (optional deployment fallback) ----------
# The copilot receives schema/preflight metadata only. It cannot access record values,
# credentials, mappings storage, or execution tools. Admins can instead save an encrypted
# workspace key from /#copilot.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
